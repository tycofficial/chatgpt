{
  "name": "chatgpt-web-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve-native-client.mjs",
    "start": "node scripts/serve-native-client.mjs",
    "check": "node scripts/check-native-client.mjs",
    "test": "node --test tests/*.test.mjs",
    "vendor": "node scripts/vendor.mjs",
    "release:prepare": "node scripts/build-native-client.mjs --services-only --activate",
    "native:check": "node scripts/check-native-client.mjs",
    "reference:export": "node --use-env-proxy scripts/export-reference.mjs",
    "reference:check": "node --use-env-proxy scripts/probe-native-upstream.mjs"
  },
  "dependencies": {
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.25",
    "mammoth": "^1.11.0",
    "marked": "^17.0.0",
    "pdfjs-dist": "^5.4.394"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.15"
  }
}
